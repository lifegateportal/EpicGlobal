# Frontend settings (Vite embeds VITE_* values in the built client).
VITE_SOCKET_URL=http://localhost:4000

# Backend settings.
PORT=4000
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_OWNER_PASSWORD=
VAULT_MASTER_KEY=
SERVER_SECRETS_KEY=
DEEPSEEK_API_KEY=

# Optional Cloudflare integration.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Optional access to private GitHub repositories.
GITHUB_TOKEN=

# Optional deployment notifications. Telegram requires both values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Optional Namecheap integration.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_SANDBOX=false
NC_FIRST_NAME=
NC_LAST_NAME=
NC_ADDRESS=
NC_CITY=
NC_STATE=
NC_POSTAL=
NC_COUNTRY=
NC_PHONE=
NC_EMAIL=